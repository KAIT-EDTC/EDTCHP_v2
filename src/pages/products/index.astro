---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProducts, productImage } from '../../lib/products';
import { PRODUCT_TAGS } from '../../lib/tags';
import hero from '../../assets/img/EDTC-teaching-machine.webp';
import fallback from '../../assets/img/EDTC-icon.webp';
import '../../styles/product.css';

const products = await getProducts();
---

<Base title="プロダクト" description="神奈川工科大学EDTCが開発した教材・製品の一覧ページです。">
    <section class="pdct-hero" aria-label="プロダクトヒーロー">
        <Image src={hero} alt="" class="pdct-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="pdct-hero__overlay">
            <h1 class="pdct-hero__title">Product</h1>
            <p class="pdct-hero__desc">EDTCが開発した教材・製品をご紹介します。</p>
        </div>
    </section>

    <section class="pdct-filters" aria-label="プロダクトフィルタ">
        <div class="pdct-filters__row">
            <div class="pdct-filters__age">
                <span class="pdct-filters__label">対象年齢</span>
                <div class="pdct-filters__tags" role="group" aria-label="対象年齢フィルタ">
                    <button type="button" class="pdct-filters__tag-btn" data-tag="" aria-pressed="true">すべて</button>
                    {PRODUCT_TAGS.map((t) => <button type="button" class="pdct-filters__tag-btn" data-tag={t} aria-pressed="false">{t}</button>)}
                </div>
            </div>
        </div>
        <div class="pdct-filters__meta">
            <span class="pdct-filters__count" aria-live="polite">{products.length}件のプロダクト</span>
            <button class="pdct-filters__clear" type="button" hidden>フィルタをクリア</button>
        </div>
    </section>

    <div class="pdct-area">
        <ul class="pdct-container">
            {
                products.map(({ id, data }) => (
                    <li class="pdct-card" data-tags={data.tags.join('|')}>
                        <a href={`/products/${id}/`}>
                            <div class="pdct-card__img-wrap">
                                <Image class="pdct-card__img" src={productImage(data.thumbnail) ?? fallback} alt={data.title} width={640} height={360} fit="cover" />
                                {data.tags.length > 0 && (
                                    <div class="pdct-card__tags">
                                        {data.tags.map((t) => <span class="pdct-card__tag">{t}</span>)}
                                    </div>
                                )}
                            </div>
                            <div class="pdct-card__body">
                                <h2 class="pdct-card__title">{data.title}</h2>
                                <p class="pdct-card__caption">{data.caption}</p>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
        <p class="pdct-empty" hidden>条件に一致するプロダクトがありません。</p>
    </div>
    <nav class="pagination-area pagination-area--bottom" aria-label="ページネーション" hidden></nav>

    <script>
        import { initCardFilter } from '../../scripts/cardFilter';
        initCardFilter({ prefix: 'pdct', matchAllTags: false });
    </script>
</Base>
