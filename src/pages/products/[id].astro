---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProducts, productImage } from '../../lib/products';
import fallback from '../../assets/img/EDTC-icon.webp';
import '../../styles/product-temp.css';

export async function getStaticPaths() {
    const products = await getProducts();
    return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
    product: CollectionEntry<'products'>;
}
const { data } = Astro.props.product;
const image = productImage(data.thumbnail);
const ogImage = image ? (await getImage({ src: image, width: 1200, format: 'jpeg' })).src : undefined;
---

<Base title={data.title} description={data.caption} image={ogImage}>
    <nav aria-label="パンくずリスト">
        <div class="breadcrumbs">
            <a href="/products/">商品一覧</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{data.title}</span>
        </div>
    </nav>
    <div id="product-main">
        <div class="main-content">
            <div class="content-left">
                {data.headline && <h1>{data.headline}</h1>}
                {data.sections.flatMap((s) => s.paragraphs).map((p) => <p>{p}</p>)}
                {data.price && <p>値段：{data.price}</p>}
                {data.target && <p>対象：{data.target}</p>}
                <a href="/contact/" class="cta-button">
                    気軽にご相談ください！
                    <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"></path></svg></span>
                </a>
            </div>
            <div class="content-right">
                <Image src={image ?? fallback} alt={data.title} widths={[480, 960]} sizes="(max-width: 768px) 100vw, 50vw" loading="eager" />
            </div>
        </div>
        {
            data.maker && (
                <div class="info-section">
                    <h3>Maker</h3>
                    <p>{data.maker}</p>
                </div>
            )
        }
    </div>
    <div id="prev"><a href="/products/">← 商品一覧へ戻る</a></div>
</Base>
