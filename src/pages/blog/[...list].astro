---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, getTags, getFilters, filterSegments, filterHref, type BlogEntry, type BlogFilter } from '../../lib/blog';
import { paginate } from '../../lib/listing';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';
import '../../styles/blog.css';

/** 記事がある絞り込み（年 × 複数タグ）ごとに、15件ずつのページを静的に出力する */
export async function getStaticPaths() {
    const posts = await getPosts();
    // ponytail: タグ名に / # ? など URL で特別な文字を含むと、ページが引けない/入れ子になる。必要になれば slug 化する
    return paginate(
        getFilters(posts).map(({ items, ...filter }) => ({ base: filterSegments(filter).join('/'), items, props: filter })),
    );
}

interface Props extends BlogFilter {
    items: BlogEntry[];
    page: number;
    total: number;
    count: number;
}
const { items, page, total, count, year, tags: selected } = Astro.props;

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const allTags = getTags(posts);
const exists = new Set(getFilters(posts).map(filterHref));

interface Pill {
    label: string;
    to: BlogFilter;
    current: boolean;
}
const yearPills: Pill[] = [
    { label: 'すべて', to: { tags: selected }, current: !year },
    ...years.map((y) => ({ label: `${y}年`, to: { year: y, tags: selected }, current: y === year })),
];
const tagPills: Pill[] = [
    { label: 'すべて', to: { year, tags: [] }, current: selected.length === 0 },
    ...allTags.map((t) => {
        const on = selected.includes(t);
        return { label: t, to: { year, tags: on ? selected.filter((x) => x !== t) : [...selected, t] }, current: on };
    }),
];

const base = filterHref({ year, tags: selected });
const label = [year && `${year}年`, selected.length > 0 && selected.map((t) => `「${t}」`).join('')].filter(Boolean).join(' ');
const title = ['ブログ', label, page > 1 && `${page}ページ目`].filter(Boolean).join(' ');
---

<Base title={title} description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。">
    <section class="blog-hero" aria-label="ブログヒーロー">
        <Image src={hero} alt="" class="blog-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="blog-hero__overlay">
            <h1 class="blog-hero__title">Blog</h1>
            <p class="blog-hero__desc">EDTCの活動や日々の取り組みをお届けします。</p>
        </div>
    </section>

    <section class="blog-filters" aria-label="記事フィルタ">
        <div class="blog-filters__row">
            {
                [
                    { name: '年', pills: yearPills },
                    { name: 'タグ（複数選択可）', pills: tagPills },
                ].map(({ name, pills }) => (
                    <div class="blog-filters__group">
                        <span class="blog-filters__label">{name}</span>
                        <nav class="blog-filters__tags" aria-label={`${name}フィルタ`}>
                            {pills.map(({ label, to, current }) =>
                                exists.has(filterHref(to)) ? (
                                    <a class="blog-filters__tag" href={filterHref(to)} aria-current={current ? 'true' : undefined}>{label}</a>
                                ) : (
                                    <span class="blog-filters__tag" aria-disabled="true">{label}</span>
                                ),
                            )}
                        </nav>
                    </div>
                ))
            }
        </div>
        <div class="blog-filters__meta">
            <span class="blog-filters__count">{count}件の記事</span>
        </div>
    </section>

    <div class="blog-area">
        <ul class="blog-container">
            {items.map((post) => <BlogCard post={post} />)}
        </ul>
    </div>
    <Pagination base={base} page={page} total={total} />
</Base>
