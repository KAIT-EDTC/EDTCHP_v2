---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { formatDate, getPosts, relatedPosts, type BlogEntry } from '../../lib/blog';
import { sectionsOf } from '../../lib/sections';
import fallback from '../../assets/img/EDTC-icon.webp';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post, related: relatedPosts(post, posts) },
    }));
}

interface Props {
    post: BlogEntry;
    related: BlogEntry[];
}
const { post, related } = Astro.props;
const { title, date, author, description, thumbnail } = post.data;
const { Content } = await render(post);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={title} description={description} image={thumbnail} type="article" background="cream">
    <div class="container post-page">
        <Breadcrumbs items={[{ label: 'ブログ', href: '/blog/' }, { label: title }]} />

        <div class="post">
            <article class="post__main panel">
                <header class="post__header">
                    <div class="chips">
                        {sectionsOf(post).map((s) => (
                            <a class="chip" href={s.href}>
                                {s.label}
                            </a>
                        ))}
                    </div>
                    <h1 class="post__title">{title}</h1>
                    <p class="post__meta">
                        <span>
                            イベント実施日 <time datetime={iso(date)}>{formatDate(date)}</time>
                        </span>
                        {author && <span>執筆者：{author}</span>}
                    </p>
                </header>
                <div class="prose">
                    <Content />
                </div>
            </article>

            <aside class="post__side">
                <section class="side-card panel" aria-labelledby="share-heading">
                    <h2 class="side-card__title" id="share-heading">この記事をシェア</h2>
                    <ShareButtons title={title} />
                </section>

                <section class="side-card panel" aria-labelledby="related-heading">
                    <h2 class="side-card__title" id="related-heading">関連記事</h2>
                    <ul class="related-posts">
                        {
                            related.map((p) => (
                                <li>
                                    <a class="related-posts__link" href={`/blog/${p.id}/`}>
                                        <Image
                                            class="related-posts__img"
                                            src={p.data.thumbnail ?? fallback}
                                            alt=""
                                            width={176}
                                            height={120}
                                            fit="cover"
                                        />
                                        <span class="related-posts__body">
                                            <time class="related-posts__date" datetime={iso(p.data.date)}>
                                                {formatDate(p.data.date)}
                                            </time>
                                            <span class="related-posts__title">{p.data.title}</span>
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                    <a class="side-card__more" href="/blog/">
                        ブログ一覧へ <span aria-hidden="true">→</span>
                    </a>
                </section>
            </aside>
        </div>
    </div>
</Base>

<style>
    .post-page {
        padding-bottom: 64px;
    }
    .post {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 32px;
        align-items: start;
    }
    .post__main {
        padding: clamp(20px, 4vw, 48px);
    }
    .post__header {
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--color-border);
    }
    .post__title {
        margin: 12px 0 10px;
        font-size: clamp(1.4rem, 3vw, 2rem);
        line-height: 1.45;
        font-weight: 700;
        color: var(--color-text);
    }
    .post__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 20px;
        font-size: 0.875rem;
        color: var(--color-text-muted);
    }

    .post__side {
        position: sticky;
        top: 90px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .side-card {
        padding: 20px;
    }
    .side-card__title {
        margin-bottom: 14px;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-text);
    }
    .side-card__more {
        display: block;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-main);
        text-align: right;
        text-decoration: none;
    }
    .side-card__more:hover {
        text-decoration: underline;
    }

    /* 関連記事 */
    .related-posts {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .related-posts__link {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 8px;
        margin: 0 -8px;
        border-radius: 10px;
        color: inherit;
        text-decoration: none;
        transition: background 0.15s;
    }
    .related-posts__link:hover {
        background: var(--color-main-tint);
    }
    .related-posts__img {
        flex-shrink: 0;
        width: 88px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        background: var(--color-bg-gray);
    }
    .related-posts__body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }
    .related-posts__date {
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }
    .related-posts__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.5;
    }
    .related-posts__link:hover .related-posts__title {
        color: var(--color-main);
    }

    @media (max-width: 900px) {
        .post {
            grid-template-columns: 1fr;
        }
        .post__side {
            position: static;
        }
    }
</style>
