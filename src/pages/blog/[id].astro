---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type BlogEntry } from '../../lib/blog';
import '../../styles/blog-temp.css';

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 5) },
    }));
}

interface Props {
    post: BlogEntry;
    others: BlogEntry[];
}
const { post, others } = Astro.props;
const { title, date, author, description, thumbnail } = post.data;
const { Content } = await render(post);
const ogImage = thumbnail ? (await getImage({ src: thumbnail, width: 1200, format: 'jpeg' })).src : undefined;
---

<Base title={title} description={description} image={ogImage} type="article">
    <nav aria-label="パンくずリスト">
        <div class="breadcrumbs">
            <a href="/blog/">ブログ</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{title}</span>
        </div>
    </nav>
    <h1 class="blog-title">{title}</h1>
    <div class="blog-date">イベント実施日: <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></div>

    <div class="blog-body">
        <article class="blog-main">
            <div class="blog-content">
                <Content />
            </div>
            {
                author && (
                    <div class="author-container">
                        <p class="author-caption">ブログ著者</p>
                        <p class="author">{author}</p>
                    </div>
                )
            }
        </article>
        <aside class="pc-only">
            <div class="side-menu">
                <div class="Archives">
                    <h3>他の記事もどうぞ！</h3>
                    <ul>
                        {others.map((p) => <li><a href={`/blog/${p.id}/`}><span class="archives-note" title={p.data.title}>{p.data.title}</span></a></li>)}
                    </ul>
                </div>
            </div>
        </aside>
    </div>

    <div class="share-buttons">
        <button class="share-btn share-x" type="button" aria-label="Xで共有">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        </button>
        <button class="share-btn share-copy" type="button" aria-label="リンクをコピー">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M13.723 18.654l-3.61 3.609c-2.316 2.315-6.063 2.315-8.378 0-1.12-1.118-1.735-2.606-1.735-4.188 0-1.582.615-3.07 1.734-4.189l4.866-4.865c2.355-2.355 6.114-2.262 8.377 0 .453.453.81.973 1.089 1.527l-1.593 1.592c-.18-.613-.5-1.189-.964-1.652-1.448-1.448-3.93-1.51-5.439-.001l-.001.002-4.867 4.865c-1.5 1.499-1.5 3.941 0 5.44 1.517 1.517 3.958 1.488 5.442 0l2.425-2.424c.993.284 1.791.335 2.654.284zm.161-16.918l-3.574 3.576c.847-.05 1.655 0 2.653.283l2.393-2.389c1.498-1.502 3.94-1.5 5.44-.001 1.517 1.518 1.486 3.959 0 5.442l-4.831 4.831-.003.002c-1.438 1.437-3.886 1.552-5.439-.002-.473-.474-.785-1.042-.956-1.643l-.084.068-1.517 1.515c.28.556.635 1.075 1.088 1.528 2.245 2.245 6.004 2.374 8.378 0l4.832-4.831c2.314-2.316 2.316-6.062-.001-8.377-2.317-2.321-6.067-2.313-8.379-.002z"></path></svg>
        </button>
    </div>
    <div id="prev"><a href="/blog/">← ブログ一覧へ戻る</a></div>

    <script>
        const check = '<svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M24 4.685l-16.327 17.315-7.673-9.054.761-.648 6.95 8.203 15.561-16.501.728.685z"/></svg>';
        document.querySelector('.share-x')?.addEventListener('click', () => {
            const text = document.querySelector('.blog-title')?.textContent ?? document.title;
            const url = `https://x.com/intent/tweet?url=${encodeURIComponent(location.href)}&text=${encodeURIComponent(text)}`;
            window.open(url, '_blank', 'noopener,noreferrer,width=550,height=420');
        });
        document.querySelector('.share-copy')?.addEventListener('click', async (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            await navigator.clipboard.writeText(location.href).catch(() => {});
            const original = btn.innerHTML;
            btn.innerHTML = check;
            setTimeout(() => (btn.innerHTML = original), 1500);
        });
    </script>
</Base>

<style>
    /* Markdown 本文。ダッシュボードのプレビューと大きくずれないよう素直なスタイルにする */
    .blog-content {
        padding-top: 1em;
        line-height: 1.9;
    }
    .blog-content :global(p) {
        margin: 0 0 1em;
    }
    .blog-content :global(h2) {
        font-size: 1.4em;
        margin: 1.6em 0 0.6em;
        padding-left: 8px;
        border-left: 4px solid var(--main-color);
    }
    .blog-content :global(h3) {
        font-size: 1.2em;
        margin: 1.4em 0 0.5em;
    }
    .blog-content :global(img) {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: 80vh;
        height: auto;
        margin: 1em auto;
        border-radius: 8px;
    }
    .blog-content :global(ul),
    .blog-content :global(ol) {
        margin: 0 0 1em 1.5em;
    }
    .blog-content :global(ul) {
        list-style: disc;
    }
    .blog-content :global(ol) {
        list-style: decimal;
    }
    .blog-content :global(a) {
        color: var(--main-color);
        text-decoration: underline;
    }
    .blog-content :global(blockquote) {
        margin: 0 0 1em;
        padding: 0.5em 1em;
        border-left: 4px solid #ccc;
        color: #555;
    }
    .blog-content :global(table) {
        border-collapse: collapse;
        margin: 0 0 1em;
    }
    .blog-content :global(th),
    .blog-content :global(td) {
        border: 1px solid #ccc;
        padding: 4px 8px;
    }
</style>
