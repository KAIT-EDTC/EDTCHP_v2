---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, getSections } from '../../lib/blog';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';
import '../../styles/blog.css';

/** 各セクションで見せる件数（残りはタグごとの一覧ページへ） */
const PREVIEW = 3;

const sections = getSections(await getPosts());
---

<Base title="ブログ" description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。">
    <section class="blog-hero" aria-label="ブログヒーロー">
        <Image src={hero} alt="" class="blog-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="blog-hero__overlay">
            <h1 class="blog-hero__title">Blog</h1>
            <p class="blog-hero__desc">EDTCの活動や日々の取り組みをお届けします。</p>
        </div>
    </section>

    <nav class="blog-nav" aria-label="活動の種類">
        <ul class="blog-nav__list">
            {
                sections.map(({ tag, slug, posts }) => (
                    <li>
                        <a class="blog-nav__link" href={`#${slug}`}>
                            {tag}
                            <span class="blog-nav__count">{posts.length}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        sections.map(({ tag, slug, intro, posts }) => (
            <section class="blog-section" id={slug} aria-labelledby={`${slug}-title`}>
                <div class="blog-section__head">
                    <h2 class="blog-section__title" id={`${slug}-title`}>
                        <a href={`/blog/tag/${slug}/`}>{tag}</a>
                        <span class="blog-section__count">{posts.length}件</span>
                    </h2>
                    {intro && <p class="blog-section__intro">{intro}</p>}
                </div>
                <ul class="blog-container">
                    {posts.slice(0, PREVIEW).map((post) => <BlogCard post={post} />)}
                </ul>
                {posts.length > PREVIEW && (
                    <a class="blog-section__more" href={`/blog/tag/${slug}/`}>
                        {tag}の記事をすべて見る（{posts.length}件）→
                    </a>
                )}
            </section>
        ))
    }
</Base>
