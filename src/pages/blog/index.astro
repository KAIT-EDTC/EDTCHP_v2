---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, getSections } from '../../lib/blog';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';
import '../../styles/blog.css';

/** カルーセルに並べる件数（新しい順。全件はタグごとの一覧ページへ） */
const CAROUSEL_MAX = 12;
/** 「すべて見る」リンクを出す件数（これを超えるセクションだけ） */
const MORE_FROM = 3;

const sections = getSections(await getPosts());
---

<Base title="ブログ" description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。">
    <section class="blog-hero" aria-label="ブログヒーロー">
        <Image src={hero} alt="" class="blog-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="blog-hero__overlay">
            <h1 class="blog-hero__title">Blog</h1>
            <p class="blog-hero__desc">EDTCの活動や日々の取り組みをお届けします。</p>
        </div>
    </section>

    <nav class="blog-nav" aria-label="活動の種類">
        <ul class="blog-nav__list">
            {
                sections.map(({ tag, slug, posts }) => (
                    <li>
                        <a class="blog-nav__link" href={`#${slug}`}>
                            {tag}
                            <span class="blog-nav__count">{posts.length}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        sections.map(({ tag, slug, intro, posts }) => (
            <section class="blog-section" id={slug} aria-labelledby={`${slug}-title`}>
                <div class="blog-section__head">
                    <h2 class="blog-section__title" id={`${slug}-title`}>
                        <a href={`/blog/tag/${slug}/`}>{tag}</a>
                        <span class="blog-section__count">{posts.length}件</span>
                    </h2>
                    {intro && <p class="blog-section__intro">{intro}</p>}
                </div>
                <div class="blog-carousel" data-carousel>
                    <button type="button" class="blog-carousel__btn blog-carousel__btn--prev" data-carousel-prev aria-label={`${tag}の前の記事`} hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg>
                    </button>
                    <ul class="blog-carousel__track" data-carousel-track tabindex="0" aria-label={`${tag}の記事`}>
                        {posts.slice(0, CAROUSEL_MAX).map((post) => <BlogCard post={post} />)}
                    </ul>
                    <button type="button" class="blog-carousel__btn blog-carousel__btn--next" data-carousel-next aria-label={`${tag}の次の記事`} hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
                {posts.length > MORE_FROM && (
                    <a class="blog-section__more" href={`/blog/tag/${slug}/`}>
                        {tag}の記事をすべて見る（{posts.length}件）→
                    </a>
                )}
            </section>
        ))
    }

    <script>
        // 矢印は横スクロールの補助。JSがなくてもスワイプ・トラックパッド・キーボードで送れるので、矢印は最初は隠しておく
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
            const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
            const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
            const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]')!;

            // 1回で、見えているカードぶん進む
            const move = (dir: number) => {
                const [a, b] = track.children as HTMLCollectionOf<HTMLElement>;
                const step = b ? b.offsetLeft - a.offsetLeft : track.clientWidth;
                const gap = b ? step - a.offsetWidth : 0;
                // 端数ぶん（次のカードののぞき）は数えず、完全に見えている枚数ぶん進む
                const visible = Math.max(1, Math.floor((track.clientWidth + gap) / step + 0.01));
                track.scrollBy({ left: dir * visible * step, behavior: smooth ? 'smooth' : 'auto' });
            };
            const update = () => {
                const overflow = track.scrollWidth > track.clientWidth + 1;
                prev.hidden = next.hidden = !overflow;
                prev.disabled = track.scrollLeft <= 1;
                next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
            };
            prev.addEventListener('click', () => move(-1));
            next.addEventListener('click', () => move(1));
            track.addEventListener('scroll', update, { passive: true });
            new ResizeObserver(update).observe(track);
            update();
        });
    </script>
</Base>
