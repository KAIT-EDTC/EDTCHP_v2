---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, getTags } from '../../lib/blog';
import { BLOG_TAG_INTRO } from '../../lib/tags';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';
import '../../styles/blog.css';

/** 各セクションで最初から見せる件数（残りは「すべて見る」に入れる） */
const PREVIEW = 3;

const posts = await getPosts();
const known = Object.keys(BLOG_TAG_INTRO);
const tags = [...new Set([...known, ...getTags(posts)])];
const sections = [
    ...tags.map((tag) => ({ tag, intro: BLOG_TAG_INTRO[tag], posts: posts.filter((p) => p.data.tags.includes(tag)) })),
    { tag: 'その他', intro: undefined, posts: posts.filter((p) => p.data.tags.length === 0) },
].filter((s) => s.posts.length > 0);
---

<Base title="ブログ" description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。">
    <section class="blog-hero" aria-label="ブログヒーロー">
        <Image src={hero} alt="" class="blog-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="blog-hero__overlay">
            <h1 class="blog-hero__title">Blog</h1>
            <p class="blog-hero__desc">EDTCの活動や日々の取り組みをお届けします。</p>
        </div>
    </section>

    <nav class="blog-nav" aria-label="活動の種類">
        <ul class="blog-nav__list">
            {
                sections.map(({ tag, posts }, i) => (
                    <li>
                        <a class="blog-nav__link" href={`#tag-${i}`}>
                            {tag}
                            <span class="blog-nav__count">{posts.length}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        sections.map(({ tag, intro, posts }, i) => (
            <section class="blog-section" id={`tag-${i}`} aria-labelledby={`tag-${i}-title`}>
                <div class="blog-section__head">
                    <h2 class="blog-section__title" id={`tag-${i}-title`}>
                        {tag}
                        <span class="blog-section__count">{posts.length}件</span>
                    </h2>
                    {intro && <p class="blog-section__intro">{intro}</p>}
                </div>
                <ul class="blog-container">
                    {posts.slice(0, PREVIEW).map((post) => <BlogCard post={post} />)}
                </ul>
                {posts.length > PREVIEW && (
                    <details class="blog-section__more">
                        <summary>すべて見る（{posts.length}件）</summary>
                        <ul class="blog-container">
                            {posts.slice(PREVIEW).map((post) => <BlogCard post={post} />)}
                        </ul>
                    </details>
                )}
            </section>
        ))
    }
</Base>
