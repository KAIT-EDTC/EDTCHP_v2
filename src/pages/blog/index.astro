---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import Carousel from '../../components/Carousel.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts } from '../../lib/blog';
import { getSections } from '../../lib/sections';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';
import '../../styles/blog.css';

/** カルーセルに並べる件数（新しい順。全件はタグごとの一覧ページへ） */
const CAROUSEL_MAX = 12;
/** 「年度別に見る」リンクを出す件数（これを超えるセクションだけ） */
const MORE_FROM = 3;

const sections = getSections(await getPosts());
---

<Base title="ブログ" description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。">
    <section class="blog-hero" aria-label="ブログヒーロー">
        <Image src={hero} alt="" class="blog-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="blog-hero__overlay">
            <h1 class="blog-hero__title">Blog</h1>
            <p class="blog-hero__desc">EDTCの活動や日々の取り組みをお届けします。</p>
        </div>
    </section>

    <div class="page-breadcrumbs">
        <Breadcrumbs items={[{ label: 'ブログ' }]} />
    </div>

    <nav class="blog-nav" aria-label="活動の種類">
        <ul class="blog-nav__list">
            {
                sections.map(({ id, label, posts }) => (
                    <li>
                        <a class="blog-nav__link" href={`#${id}`}>
                            {label}
                            <span class="blog-nav__count">{posts.length}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        sections.map(({ id, label, intro, href, posts }) => (
            <section class="blog-section" id={id} aria-labelledby={`${id}-title`}>
                <div class="blog-section__head">
                    <h2 class="blog-section__title" id={`${id}-title`}>
                        <a href={href}>{label}</a>
                        <span class="blog-section__count">{posts.length}件</span>
                    </h2>
                    <p class="blog-section__intro">{intro}</p>
                </div>
                <Carousel class="blog-carousel" label={label} item="記事" list>
                    {posts.slice(0, CAROUSEL_MAX).map((post) => <BlogCard post={post} />)}
                </Carousel>
                {posts.length > MORE_FROM && (
                    <a class="blog-section__more" href={href}>
                        {label}を年度別に見る（{posts.length}件）→
                    </a>
                )}
            </section>
        ))
    }
</Base>
