---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Carousel from '../../components/Carousel.astro';
import { getPosts } from '../../lib/blog';
import { getSections } from '../../lib/sections';
import hero from '../../assets/img/EDTC-GroupPhoto.webp';

/** カルーセルに並べる件数（新しい順。全件はタグごとの一覧ページへ） */
const CAROUSEL_MAX = 12;
/** 「年度別に見る」リンクを出す件数（これを超えるセクションだけ） */
const MORE_FROM = 3;

const sections = getSections(await getPosts());
---

<Base title="ブログ" description="神奈川工科大学EDTCのブログ記事一覧。活動報告やイベント情報をお届けします。" background="gray">
    <PageHero title="Blog" description="EDTCの活動や日々の取り組みをお届けします。" image={hero} />

    <div class="container">
        <Breadcrumbs items={[{ label: 'ブログ' }]} />
    </div>

    <nav class="blog-nav" aria-label="活動の種類">
        <ul class="blog-nav__list container">
            {
                sections.map(({ id, label, posts }) => (
                    <li>
                        <a class="blog-nav__link" href={`#${id}`}>
                            {label}
                            <span class="blog-nav__count">{posts.length}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    {
        sections.map(({ id, label, intro, href, posts }) => (
            <section class="blog-section" id={id} aria-labelledby={`${id}-title`}>
                <div class="container">
                    <SectionHeading title={label} count={posts.length} intro={intro} href={href} id={id} level={2} />
                </div>
                <Carousel label={label} item="記事">
                    {posts.slice(0, CAROUSEL_MAX).map((post) => (
                        <BlogCard post={post} headingLevel={3} />
                    ))}
                </Carousel>
                {posts.length > MORE_FROM && (
                    <div class="container">
                        <a class="blog-section__more" href={href}>
                            {label}を年度別に見る（{posts.length}件）→
                        </a>
                    </div>
                )}
            </section>
        ))
    }
</Base>

<style>
    .blog-nav__list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .blog-nav__link {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.35em 0.9em;
        border: 1.5px solid var(--color-main);
        border-radius: var(--radius-pill);
        color: var(--color-main);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
    }
    .blog-nav__link:hover {
        background: var(--color-main);
        color: #fff;
    }
    .blog-nav__count {
        font-size: 0.75rem;
        font-weight: 400;
        opacity: 0.8;
    }

    .blog-section {
        margin-top: 3rem;
        scroll-margin-top: 80px; /* 固定ヘッダーの下に見出しが来るように */
    }
    .blog-section:last-of-type {
        margin-bottom: 4rem;
    }
    .blog-section__more {
        display: block;
        width: fit-content;
        margin: 1.2rem auto 0;
        padding: 0.5em 1.4em;
        border: 1.5px solid var(--color-main);
        border-radius: var(--radius-pill);
        color: var(--color-main);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
    }
    .blog-section__more:hover {
        background: var(--color-main);
        color: #fff;
    }
</style>
