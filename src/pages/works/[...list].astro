---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import { getWorks } from '../../lib/works';
import { paginate } from '../../lib/listing';
import { WORK_TAGS } from '../../lib/tags';
import hero from '../../assets/img/EDTC-teaching-machine.webp';
import fallback from '../../assets/img/EDTC-icon.webp';
import '../../styles/works.css';

type Work = Awaited<ReturnType<typeof getWorks>>[number];

/** 一覧 / 対象年齢別を静的に出力する（該当0件のタグはページを作らない） */
export async function getStaticPaths() {
    const works = await getWorks();
    return paginate([
        { items: works },
        ...WORK_TAGS.map((tag) => ({ base: `tag/${tag}`, items: works.filter((w) => w.data.tags.includes(tag)), props: { tag } })).filter(
            (g) => g.items.length > 0,
        ),
    ]);
}

interface Props {
    items: Work[];
    page: number;
    total: number;
    count: number;
    tag?: string;
}
const { items, page, total, count, tag } = Astro.props;
const base = tag ? `/works/tag/${encodeURIComponent(tag)}/` : '/works/';
const title = ['制作物', tag && `対象年齢「${tag}」`, page > 1 && `${page}ページ目`].filter(Boolean).join(' ');
---

<Base title={title} description="神奈川工科大学EDTCが開発した教材・ロボットなどの制作物の一覧ページです。">
    <section class="works-hero" aria-label="制作物ヒーロー">
        <Image src={hero} alt="" class="works-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="works-hero__overlay">
            <h1 class="works-hero__title">Works</h1>
            <p class="works-hero__desc">EDTCが開発した教材・ロボットなどの制作物をご紹介します。</p>
        </div>
    </section>

    <section class="works-filters" aria-label="制作物フィルタ">
        <div class="works-filters__row">
            <div class="works-filters__age">
                <span class="works-filters__label">対象年齢</span>
                <nav class="works-filters__tags" aria-label="対象年齢フィルタ">
                    <a class="works-filters__tag" href="/works/" aria-current={tag ? undefined : 'page'}>すべて</a>
                    {WORK_TAGS.map((t) => <a class="works-filters__tag" href={`/works/tag/${encodeURIComponent(t)}/`} aria-current={t === tag ? 'page' : undefined}>{t}</a>)}
                </nav>
            </div>
        </div>
        <div class="works-filters__meta">
            <span class="works-filters__count">{count}件の制作物</span>
        </div>
    </section>

    <div class="works-area">
        <ul class="works-container">
            {
                items.map(({ id, data }) => (
                    <li class="works-card">
                        <a href={`/works/${id}/`}>
                            <div class="works-card__img-wrap">
                                <Image class="works-card__img" src={data.thumbnail ?? fallback} alt={data.title} width={640} height={360} fit="cover" />
                                {data.tags.length > 0 && (
                                    <div class="works-card__tags">
                                        {data.tags.map((t) => <span class="works-card__tag">{t}</span>)}
                                    </div>
                                )}
                            </div>
                            <div class="works-card__body">
                                <h2 class="works-card__title">{data.title}</h2>
                                <p class="works-card__caption">{data.description}</p>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
    <Pagination base={base} page={page} total={total} />
</Base>
