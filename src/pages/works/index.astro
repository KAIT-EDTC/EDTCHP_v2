---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import PageHero from '../../components/PageHero.astro';
import { getWorks } from '../../lib/works';
import hero from '../../assets/img/EDTC-teaching-machine.webp';
import fallback from '../../assets/img/EDTC-icon.webp';

const works = await getWorks();
---

<Base title="制作物" description="神奈川工科大学EDTCが開発した教材・ロボットなどの制作物の一覧ページです。" background="gray">
    <PageHero title="Works" description="EDTCが開発した教材・ロボットなどの制作物をご紹介します。" image={hero} />

    <div class="container">
        <Breadcrumbs items={[{ label: '制作物' }]} />
    </div>

    <ul class="container card-grid">
        {
            works.map(({ id, data }) => (
                <Card href={`/works/${id}/`} title={data.title} description={data.description} image={data.thumbnail ?? fallback} />
            ))
        }
    </ul>
</Base>

<style>
    /* 上の余白はパンくずが持つ */
    .card-grid {
        margin-bottom: 4rem;
    }
</style>
