---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getWorks } from '../../lib/works';
import hero from '../../assets/img/EDTC-teaching-machine.webp';
import { thumbnailOf } from '../../lib/thumbnail';
import '../../styles/works.css';

const works = await getWorks();
---

<Base title="制作物" description="神奈川工科大学EDTCが開発した教材・ロボットなどの制作物の一覧ページです。">
    <section class="works-hero" aria-label="制作物ヒーロー">
        <Image src={hero} alt="" class="works-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
        <div class="works-hero__overlay">
            <h1 class="works-hero__title">Works</h1>
            <p class="works-hero__desc">EDTCが開発した教材・ロボットなどの制作物をご紹介します。</p>
        </div>
    </section>

    <div class="page-breadcrumbs">
        <Breadcrumbs items={[{ label: '制作物' }]} />
    </div>

    <div class="works-area">
        <ul class="works-container">
            {
                works.map((work) => (
                    <li class="works-card">
                        <a href={`/works/${work.id}/`}>
                            <div class="works-card__img-wrap">
                                <Image class="works-card__img" src={thumbnailOf(work)} alt={work.data.title} width={640} height={360} fit="cover" />
                            </div>
                            <div class="works-card__body">
                                <h2 class="works-card__title">{work.data.title}</h2>
                                <p class="works-card__caption">{work.data.description}</p>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>

</Base>
