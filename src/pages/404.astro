---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません">
    <div class="not-found">
        <p class="not-found__code">404</p>
        <p class="not-found__message">お探しのページが見つかりませんでした。</p>
        <a class="not-found__link" href="/">ホームに戻る</a>
    </div>
</Base>

<style>
    .not-found {
        padding: 80px 20px;
        text-align: center;
    }
    .not-found__code {
        margin-bottom: 16px;
        font-size: 2em;
        color: #ccc;
    }
    .not-found__message {
        font-size: 1.1em;
        color: var(--color-text-muted);
    }
    .not-found__link {
        display: block;
        width: fit-content;
        margin: 24px auto 0;
        color: var(--color-main);
        text-decoration: underline;
    }
</style>
