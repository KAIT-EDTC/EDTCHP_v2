---
/**
 * X・Instagram への丸いリンク。
 * 色は CSS 変数で変えられる（暗い背景に置くときは親で --sns-color / --sns-ring を白にする）
 *   --sns-color: アイコンの色 / --sns-ring: 円の枠線 / --sns-hover-color: ホバー時のアイコン色（既定はブランド色）
 */
---

<div class="sns-links">
    <a class="sns-links-link sns-links-link-x" href="https://x.com/kait_edtc" title="X" aria-label="X" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path></svg>
    </a>
    <a class="sns-links-link sns-links-link-instagram" href="https://www.instagram.com/kait.edtc/" title="Instagram" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 448 512" aria-hidden="true" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.3 0-74.7-33.4-74.7-74.7s33.4-74.7 74.7-74.7 74.7 33.4 74.7 74.7-33.4 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.9-26.9 26.9-14.9 0-26.9-12-26.9-26.9 0-14.9 12-26.9 26.9-26.9 14.9 0 26.9 12 26.9 26.9zm76.1 27.3c-1.7-35.3-9.8-66.7-35.7-92.5S354.7 37 319.4 35.3c-35.5-2-141.9-2-177.4 0-35.2 1.7-66.6 9.8-92.5 35.7S11.9 128.7 10.2 164c-2 35.5-2 141.9 0 177.4 1.7 35.3 9.8 66.7 35.7 92.5s57.3 34 92.5 35.7c35.5 2 141.9 2 177.4 0 35.3-1.7 66.7-9.8 92.5-35.7s34-57.2 35.7-92.5c2-35.5 2-141.8 0-177.4zM398.8 388c-7.7 19.4-22.7 34.4-42.1 42.1-29.1 11.5-98.2 8.9-132.6 8.9s-103.7 2.7-132.6-8.9c-19.4-7.7-34.4-22.7-42.1-42.1-11.5-29.1-8.9-98.2-8.9-132.6s-2.7-103.7 8.9-132.6c7.7-19.4 22.7-34.4 42.1-42.1 29.1-11.5 98.2-8.9 132.6-8.9s103.7-2.7 132.6 8.9c19.4 7.7 34.4 22.7 42.1 42.1 11.5 29.1 8.9 98.2 8.9 132.6s2.7 103.7-8.9 132.6z"></path></svg>
    </a>
</div>

<style>
    .sns-links {
        display: flex;
        gap: 12px;
    }
    .sns-links-link {
        /* 円の中央にアイコンを置く（table-cell + vertical-align だと上にずれる） */
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        color: var(--sns-color, #555);
        box-shadow: inset 0 0 0 2px var(--sns-ring, var(--color-text));
        transition: box-shadow 0.28s ease, color 0.28s ease;
    }
    .sns-links-link svg {
        display: block;
        width: 20px;
        height: 20px;
    }
    .sns-links-link-x {
        --sns-brand: #1b95e0;
    }
    .sns-links-link-instagram {
        --sns-brand: #2b5c84;
    }
    .sns-links-link:hover {
        /* 22px は円の半径。枠線を内側に広げて塗りつぶす */
        box-shadow: inset 0 0 0 22px #fff;
        color: var(--sns-hover-color, var(--sns-brand));
    }
    @media (prefers-reduced-motion: reduce) {
        .sns-links-link {
            transition: none;
        }
    }
</style>
