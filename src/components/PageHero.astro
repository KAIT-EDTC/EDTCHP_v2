---
import { Image } from 'astro:assets';

interface Props {
    /** 大きく出す見出し（h1）。例: "Blog" */
    title: string;
    /** 見出しの下に出す一文 */
    description: string;
    /** 背景画像。ぼかして暗くして敷く */
    image: ImageMetadata;
}
const { title, description, image } = Astro.props;
---

<section class="page-hero">
    <Image src={image} alt="" class="page-hero__bg" width={1280} height={720} loading="eager" fetchpriority="high" />
    <div class="page-hero__overlay">
        <h1 class="page-hero__title">{title}</h1>
        <p class="page-hero__desc">{description}</p>
    </div>
</section>

<style>
    .page-hero {
        position: relative;
        height: 35vh;
        overflow: hidden;
    }
    .page-hero__bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: blur(1.5px) brightness(0.65);
        transform: scale(1.05); /* ぼかしの端の隙間を隠す */
        pointer-events: none;
    }
    .page-hero__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .page-hero__title {
        color: #fff;
        font-size: clamp(3rem, 12vw, 8rem);
        font-weight: 700;
        letter-spacing: 0.05em;
    }
    .page-hero__desc {
        margin-top: 0.8rem;
        padding: 0.5em 1.2em;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font-size: clamp(0.9rem, 2vw, 1.25rem);
    }
    @media (max-width: 900px) {
        .page-hero {
            height: 28vh;
        }
    }
    @media (max-width: 600px) {
        .page-hero {
            height: 35vw;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .page-hero__bg {
            filter: brightness(0.55);
            transform: none;
        }
    }
</style>
