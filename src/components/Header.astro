---
import { Image } from 'astro:assets';
import icon from '../assets/img/EDTC-icon.webp';
import SnsLinks from './SnsLinks.astro';

const nav = [
    { href: '/', en: 'Home', ja: 'ホーム' },
    { href: '/blog/', en: 'Blog', ja: 'ブログ' },
    { href: '/works/', en: 'Works', ja: '制作物' },
    { href: '/contact/', en: 'Contact', ja: 'お問い合わせ' },
];
---

<header class="header">
    <a class="header__logo" href="/"><Image src={icon} alt="EDTC" width={60} height={60} /></a>
    <a class="header__title" href="/">EDTC</a>
    <!-- 900px 以下はドロワー、それより広いと横並び。開閉は JS なしでチェックボックスが持つ -->
    <nav class="header__nav" aria-label="メインメニュー">
        <input id="header-toggle" class="header__toggle" type="checkbox" aria-label="メニュー切り替え" />
        <label class="header__burger" for="header-toggle"><span class="header__burger-line"></span></label>
        <label class="header__backdrop" for="header-toggle"></label>
        <div class="header__drawer">
            <ul class="header__list">
                {
                    nav.map((n) => (
                        <li>
                            <a class="header__link" href={n.href}>
                                <span class="header__en">{n.en}</span>
                                <span class="header__ja">{n.ja}</span>
                            </a>
                        </li>
                    ))
                }
                <li class="header__sns"><SnsLinks /></li>
            </ul>
        </div>
    </nav>
</header>

<style>
    .header {
        position: fixed;
        top: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        width: 100%;
        height: var(--layout-header-height);
        padding: 0 4%;
        background-color: #fff;
    }
    .header__logo {
        display: block;
    }
    .header__logo :global(img) {
        display: block;
    }
    .header__title {
        font-size: 25px;
        font-weight: bold;
    }
    .header__nav {
        margin: 0 1% 0 auto;
    }

    /* ---- スマホ: ハンバーガー + ドロワー ---- */
    /* display: none だとキーボードで開けないので、見えないだけにする */
    .header__toggle {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }
    .header__burger {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        cursor: pointer;
    }
    .header__toggle:focus-visible ~ .header__burger {
        outline: 2px solid var(--color-main);
        outline-offset: 2px;
    }
    .header__burger-line,
    .header__burger-line::before,
    .header__burger-line::after {
        display: block;
        width: 25px;
        height: 3px;
        border-radius: 3px;
        background: #555;
    }
    .header__burger-line {
        position: relative;
    }
    .header__burger-line::before,
    .header__burger-line::after {
        content: '';
        position: absolute;
        left: 0;
    }
    .header__burger-line::before {
        top: -8px;
    }
    .header__burger-line::after {
        top: 8px;
    }
    /* 閉じる用の薄黒い背景 */
    .header__backdrop {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: #000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease-in-out;
    }
    .header__toggle:checked ~ .header__backdrop {
        opacity: 0.5;
        pointer-events: auto;
    }
    .header__drawer {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 2;
        width: 70%;
        max-width: 300px;
        height: 100%;
        overflow: auto;
        background: rgba(0, 0, 0, 0.8);
        /* 閉じている間は中のリンクにフォーカスが入らないようにする */
        visibility: hidden;
        transform: translateX(-105%);
        transition: transform 0.3s ease-in-out, visibility 0s 0.3s;
        /* ドロワーは暗い背景なので SNS アイコンは白にする */
        --sns-color: #fff;
        --sns-ring: #fff;
        --sns-hover-color: var(--color-text);
    }
    .header__toggle:checked ~ .header__drawer {
        visibility: visible;
        transform: translateX(0);
        box-shadow: 6px 0 25px rgba(0, 0, 0, 0.15);
        transition-delay: 0s;
    }
    .header__list {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
        padding-top: 60px;
    }
    .header__link {
        display: block;
        width: 200px;
        color: #fff;
        text-align: center;
    }
    .header__link:hover {
        color: #85a7cc;
    }
    .header__en,
    .header__ja {
        display: block;
    }
    .header__en {
        font-size: 16px;
        font-weight: bold;
        text-transform: uppercase;
    }
    .header__ja {
        font-size: 12px;
    }

    /* ---- PC: 横並び ---- */
    @media (min-width: 901px) {
        .header__toggle,
        .header__burger,
        .header__backdrop {
            display: none;
        }
        .header__drawer {
            position: static;
            width: auto;
            max-width: none;
            height: auto;
            overflow: visible;
            background: none;
            visibility: visible;
            transform: none;
            /* ドロワー用の白指定を戻す */
            --sns-color: initial;
            --sns-ring: initial;
            --sns-hover-color: initial;
        }
        .header__list {
            flex-direction: row;
            gap: 15px;
            padding-top: 0;
        }
        .header__link {
            width: auto;
            color: inherit;
        }
        .header__link:hover {
            color: inherit;
        }
        .header__en {
            font-size: 17px;
            text-transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .header__backdrop,
        .header__drawer {
            transition: none;
        }
    }
</style>
