---
import { Image } from 'astro:assets';
import icon from '../assets/img/EDTC-icon.webp';

const links = [
    { href: '/', label: 'ホーム' },
    { href: '/blog/', label: 'ブログ' },
    { href: '/works/', label: '制作物' },
    { href: '/contact/', label: 'お問い合わせ' },
];
---

<footer class="footer">
    <nav class="footer__nav" aria-label="フッターメニュー">
        <ul class="footer__links">
            {links.map((l) => <li><a class="footer__link" href={l.href}>{l.label}</a></li>)}
        </ul>
    </nav>
    <div class="footer__brand">
        <Image class="footer__logo" src={icon} alt="EDTCロゴ" width={50} height={50} />
        <span class="footer__name">EDTC</span>
    </div>
    <p class="footer__info">学校法人 幾徳学園 神奈川工科大学<br />mail :kait.edtc@gmail.com</p>
    <p class="footer__copy">&copy; {new Date().getFullYear()} KAIT EDTC All Rights Reserved</p>
</footer>

<style>
    .footer {
        padding: 20px 16px 15px;
        background-color: var(--color-text);
        color: #fff;
        text-align: center;
    }
    .footer__nav {
        padding-bottom: 15px;
        border-bottom: 1px solid var(--color-text-muted);
    }
    .footer__links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px 24px;
    }
    .footer__link {
        color: antiquewhite;
    }
    .footer__link:hover {
        text-decoration: underline;
    }
    .footer__brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
    }
    .footer__name {
        font-size: 3em;
        font-weight: bold;
    }
    .footer__info {
        margin-top: 5px;
        font-size: 0.9em;
    }
    .footer__copy {
        margin-top: 8px;
    }
</style>
