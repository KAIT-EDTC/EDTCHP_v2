---
import type { BlogEntry } from '../lib/blog';
import Card from './Card.astro';
import fallback from '../assets/img/EDTC-icon.webp';

interface Props {
    /** ブログ記事（getPosts() の要素） */
    post: BlogEntry;
    /** タイトルの見出しレベル（Card と同じ） */
    headingLevel?: 2 | 3;
}
const { post, headingLevel } = Astro.props;
const { title, date, description, thumbnail } = post.data;
---

<Card href={`/blog/${post.id}/`} title={title} description={description} image={thumbnail ?? fallback} date={date} headingLevel={headingLevel} />
