---
import { Image } from 'astro:assets';
import type { BlogEntry } from '../lib/blog';
import { formatDate } from '../lib/blog';
import fallback from '../assets/img/EDTC-icon.webp';

interface Props {
    post: BlogEntry;
}
const { post } = Astro.props;
const { title, date, description, tags, thumbnail } = post.data;
---

<li class="blog-card">
    <a href={`/blog/${post.id}/`}>
        <div class="blog-card__img-wrap">
            <Image class="blog-card__img" src={thumbnail ?? fallback} alt={title} width={640} height={360} fit="cover" />
            {
                tags.length > 0 && (
                    <div class="blog-card__tags">
                        {tags.map((t) => <span class="blog-card__tag">{t}</span>)}
                    </div>
                )
            }
        </div>
        <div class="blog-card__body">
            <span class="blog-card__date">{formatDate(date)}</span>
            <h2 class="blog-card__title">{title}</h2>
            <p class="blog-card__caption">{description}</p>
        </div>
    </a>
</li>
